{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/grc",
      "destination": "/grc/",
      "permanent": false
    },
    {
      "source": "/emiratisation-webinar",
      "destination": "/emiratisation-webinar/",
      "permanent": false
    },
    {
      "source": "/it-recruitment-agency-in-dubai",
      "destination": "/it-recruitment-agency-in-dubai/",
      "permanent": false
    },
    {
      "source": "/grc-recruitment",
      "destination": "/grc-recruitment/",
      "permanent": false
    },
    {
      "source": "/brandreveal",
      "destination": "/brandreveal/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/grc/",
      "destination": "/grc/index.html"
    },
    {
      "source": "/grc/:path*",
      "destination": "/grc/:path*"
    },
    {
      "source": "/emiratisation-webinar/",
      "destination": "/emiratisation-webinar/index.html"
    },
    {
      "source": "/emiratisation-webinar/:path*",
      "destination": "/emiratisation-webinar/:path*"
    },
    {
      "source": "/it-recruitment-agency-in-dubai/",
      "destination": "/it-recruitment-agency-in-dubai/index.html"
    },
    {
      "source": "/it-recruitment-agency-in-dubai/:path*",
      "destination": "/it-recruitment-agency-in-dubai/:path*"
    },
    {
      "source": "/grc-recruitment/",
      "destination": "/grc-recruitment/index.html"
    },
    {
      "source": "/grc-recruitment/:path*",
      "destination": "/grc-recruitment/:path*"
    }
  ],
  "headers": [
    {
      "source": "/brandreveal(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, must-revalidate"
        }
      ]
    },
    {
      "source": "/brandreveal/film.mp4",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        },
        {
          "key": "Accept-Ranges",
          "value": "bytes"
        }
      ]
    }
  ]
}
